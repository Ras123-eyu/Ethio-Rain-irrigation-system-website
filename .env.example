# Netlify Production / Serverless Function Environment Variables (Recommended):
# Set these securely in Netlify Site Settings -> Environment Variables
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Local Development Fallback (Optional, for running without Netlify CLI):
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
VITE_TELEGRAM_CHAT_ID=your_telegram_chat_id_here

