# Telegram Bot Credentials for Quotation Alerts
# 1. Create a bot with @BotFather on Telegram to get your BOT_TOKEN
# 2. Get your CHAT_ID (your user ID or group/channel ID) via @userinfobot or @RawDataBot
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
VITE_TELEGRAM_CHAT_ID=your_telegram_chat_id_here
